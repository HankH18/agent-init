#!/usr/bin/env bash
# agent-init — opinionated, idempotent project scaffolding for AI coding agents
# v2.0.0
#
# Sets up a single project to work optimally with Claude Code, OpenAI Codex CLI,
# or both — using a shared `.agents/` source of truth so the two tools stay in
# sync automatically. Polyglot stack detection, configurable per-agent model
# tiers, best-practice hooks, sub-agents, skills, and MCP server reference.
#
# Subcommands:
#   agent-init [init] [options]     Initialize / refresh a project (default)
#   agent-init sync [options]       Re-render .claude/ and .codex/ from .agents/
#   agent-init doctor [options]     Detect drift, broken links, trust issues
#   agent-init migrate [options]    Upgrade legacy claude-init projects in place
#
# Common options:
#   --agent=claude|codex|both    Which tool(s) to scaffold for (default: claude)
#   --force                      Overwrite differing files (backs them up to *.bak.<ts>)
#   --dry-run                    Show what would happen, write nothing
#   --quiet                      Suppress informational output
#   --configure                  Interactive setup of global model defaults
#   --show-config                Print resolved configuration and exit
#   -h, --help                   This message
#
# Claude model tiers (high/mid/low → opus/sonnet/haiku):
#   --planner=MODEL          Override planner specialist
#   --reviewer=MODEL         Override code-reviewer specialist
#   --test-runner=MODEL      Override test-runner specialist
#   --debugger=MODEL         Override debugger specialist
#   --preset=NAME            Apply a Claude preset (overrides individual flags)
#
# Codex model tiers (high/mid/low → gpt-5-pro/gpt-5.4/gpt-5.4-mini):
#   --codex-planner=MODEL
#   --codex-reviewer=MODEL
#   --codex-test-runner=MODEL
#   --codex-debugger=MODEL
#   --codex-preset=NAME
#
# Claude presets:
#   opus-heavy    — all four specialists on Opus (max quality)
#   balanced ★    — planner/reviewer/debugger on Opus, test-runner on Sonnet (default)
#   thrifty       — only planner on Opus, the rest on Sonnet
#   minimal       — all four on Sonnet
#   haiku-runner  — planner/reviewer/debugger on Opus, test-runner on Haiku
#
# Codex presets:
#   pro-heavy     — all four specialists on gpt-5-pro
#   balanced ★    — planner/reviewer/debugger on gpt-5-pro, test-runner on gpt-5.4
#   thrifty       — planner on gpt-5-pro, the rest on gpt-5.4
#   minimal       — all four on gpt-5.4
#   mini-runner   — planner/reviewer/debugger on gpt-5-pro, test-runner on gpt-5.4-mini
#
# Configuration priority (highest wins):
#   1. CLI flags
#   2. Environment variables (AGENT_INIT_<TIER>_MODEL, AGENT_INIT_CODEX_<TIER>_MODEL)
#   3. Config file (~/.config/agent-init/config — set via --configure)
#   4. Built-in defaults (the 'balanced' preset for both tools)
#
# Source of truth (created in every project):
#   AGENTS.md                          — canonical project memory (<200 lines)
#   CLAUDE.md                          — one-liner: @AGENTS.md (+ Claude extras, if any)
#   .agents/specialists/*.yaml         — tool-agnostic specialist IR
#   .agents/skills/<name>/SKILL.md     — cross-tool skill definitions
#   .agents/hooks/*.sh                 — shared shell scripts
#   .agents/mcp.yaml                   — logical MCP server list
#
# Generated artifacts (per --agent flag):
#   .claude/{settings.json,agents/,commands/,hooks/,MCP_SETUP.md}
#   .codex/{config.toml,hooks.json,agents/,skills/,MCP_SETUP.md}
#
# Never hand-edit the generated dirs — edit .agents/ and run `agent-init sync`.

set -euo pipefail

VERSION="2.0.0"
SUBCOMMAND="init"   # default
FORCE=0
DRY_RUN=0
VERBOSE=1
CONFIGURE=0
SHOW_CONFIG=0
AGENT_MODE="claude"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

# ============================================================================
# Default model tiers (the 'balanced' preset for both tools)
# ============================================================================

# Claude tiers: opus / sonnet / haiku
CLAUDE_PLANNER="opus"
CLAUDE_REVIEWER="opus"
CLAUDE_TESTRUNNER="sonnet"
CLAUDE_DEBUGGER="opus"

# Codex tiers: gpt-5-pro / gpt-5.4 / gpt-5.4-mini
CODEX_PLANNER="gpt-5-pro"
CODEX_REVIEWER="gpt-5-pro"
CODEX_TESTRUNNER="gpt-5.4"
CODEX_DEBUGGER="gpt-5-pro"

# Codex reasoning effort per specialist (low / medium / high)
CODEX_PLANNER_EFFORT="high"
CODEX_REVIEWER_EFFORT="high"
CODEX_TESTRUNNER_EFFORT="medium"
CODEX_DEBUGGER_EFFORT="high"

# ============================================================================
# Color / logging
# ============================================================================

if [[ -t 2 ]]; then
  R=$'\033[0m'; B=$'\033[1m'; D=$'\033[2m'
  GR=$'\033[32m'; YL=$'\033[33m'; BL=$'\033[34m'; RD=$'\033[31m'; CY=$'\033[36m'
else
  R=""; B=""; D=""; GR=""; YL=""; BL=""; RD=""; CY=""
fi
log()  { [[ $VERBOSE -eq 1 ]] && printf "%s\n" "$*" >&2 || true; }
make_() { log "${GR}+${R}  $*"; }
keep() { log "${D}=  $*${R}"; }
back() { log "${YL}~${R}  $*"; }
plan_() { log "${BL}?${R}  $*"; }
warn() { log "${YL}⚠${R}  $*"; }
err()  { log "${RD}✗${R}  $*"; }
note() { log "${CY}•${R}  $*"; }
ok()   { log "${GR}✓${R}  $*"; }

# ============================================================================
# Validation helpers
# ============================================================================

CLAUDE_MODELS_RX='^(opus|sonnet|haiku)$'
CODEX_MODELS_RX='^(gpt-5-pro|gpt-5\.4|gpt-5\.4-mini|gpt-5\.4-codex|gpt-5\.3-codex|gpt-5\.3-codex-spark)$'

validate_claude_model() {
  if ! [[ "$1" =~ $CLAUDE_MODELS_RX ]]; then
    err "Invalid Claude model '$1' — must be opus, sonnet, or haiku."
    exit 1
  fi
}
validate_codex_model() {
  if ! [[ "$1" =~ $CODEX_MODELS_RX ]]; then
    err "Invalid Codex model '$1' — must be one of: gpt-5-pro, gpt-5.4, gpt-5.4-mini, gpt-5.4-codex, gpt-5.3-codex, gpt-5.3-codex-spark."
    exit 1
  fi
}
validate_agent_mode() {
  case "$1" in
    claude|codex|both) ;;
    *) err "Invalid --agent value '$1' — must be claude, codex, or both."; exit 1 ;;
  esac
}

cap_claude() {
  case "$1" in opus) echo "Opus";; sonnet) echo "Sonnet";; haiku) echo "Haiku";; *) echo "$1";; esac
}
cap_codex() {
  # Codex names are already presentation-friendly; just return them.
  echo "$1"
}

# ============================================================================
# Presets
# ============================================================================

apply_claude_preset() {
  case "$1" in
    opus-heavy|opus_heavy)
      CLAUDE_PLANNER="opus"; CLAUDE_REVIEWER="opus"
      CLAUDE_TESTRUNNER="opus"; CLAUDE_DEBUGGER="opus" ;;
    balanced)
      CLAUDE_PLANNER="opus"; CLAUDE_REVIEWER="opus"
      CLAUDE_TESTRUNNER="sonnet"; CLAUDE_DEBUGGER="opus" ;;
    thrifty)
      CLAUDE_PLANNER="opus"; CLAUDE_REVIEWER="sonnet"
      CLAUDE_TESTRUNNER="sonnet"; CLAUDE_DEBUGGER="sonnet" ;;
    minimal)
      CLAUDE_PLANNER="sonnet"; CLAUDE_REVIEWER="sonnet"
      CLAUDE_TESTRUNNER="sonnet"; CLAUDE_DEBUGGER="sonnet" ;;
    haiku-runner|haiku_runner)
      CLAUDE_PLANNER="opus"; CLAUDE_REVIEWER="opus"
      CLAUDE_TESTRUNNER="haiku"; CLAUDE_DEBUGGER="opus" ;;
    *)
      err "Unknown Claude preset '$1'. Valid: opus-heavy, balanced, thrifty, minimal, haiku-runner"
      exit 1 ;;
  esac
}

apply_codex_preset() {
  case "$1" in
    pro-heavy|pro_heavy)
      CODEX_PLANNER="gpt-5-pro"; CODEX_REVIEWER="gpt-5-pro"
      CODEX_TESTRUNNER="gpt-5-pro"; CODEX_DEBUGGER="gpt-5-pro"
      CODEX_PLANNER_EFFORT="high"; CODEX_REVIEWER_EFFORT="high"
      CODEX_TESTRUNNER_EFFORT="high"; CODEX_DEBUGGER_EFFORT="high" ;;
    balanced)
      CODEX_PLANNER="gpt-5-pro"; CODEX_REVIEWER="gpt-5-pro"
      CODEX_TESTRUNNER="gpt-5.4"; CODEX_DEBUGGER="gpt-5-pro"
      CODEX_PLANNER_EFFORT="high"; CODEX_REVIEWER_EFFORT="high"
      CODEX_TESTRUNNER_EFFORT="medium"; CODEX_DEBUGGER_EFFORT="high" ;;
    thrifty)
      CODEX_PLANNER="gpt-5-pro"; CODEX_REVIEWER="gpt-5.4"
      CODEX_TESTRUNNER="gpt-5.4"; CODEX_DEBUGGER="gpt-5.4"
      CODEX_PLANNER_EFFORT="high"; CODEX_REVIEWER_EFFORT="medium"
      CODEX_TESTRUNNER_EFFORT="medium"; CODEX_DEBUGGER_EFFORT="medium" ;;
    minimal)
      CODEX_PLANNER="gpt-5.4"; CODEX_REVIEWER="gpt-5.4"
      CODEX_TESTRUNNER="gpt-5.4"; CODEX_DEBUGGER="gpt-5.4"
      CODEX_PLANNER_EFFORT="medium"; CODEX_REVIEWER_EFFORT="medium"
      CODEX_TESTRUNNER_EFFORT="medium"; CODEX_DEBUGGER_EFFORT="medium" ;;
    mini-runner|mini_runner)
      CODEX_PLANNER="gpt-5-pro"; CODEX_REVIEWER="gpt-5-pro"
      CODEX_TESTRUNNER="gpt-5.4-mini"; CODEX_DEBUGGER="gpt-5-pro"
      CODEX_PLANNER_EFFORT="high"; CODEX_REVIEWER_EFFORT="high"
      CODEX_TESTRUNNER_EFFORT="low"; CODEX_DEBUGGER_EFFORT="high" ;;
    *)
      err "Unknown Codex preset '$1'. Valid: pro-heavy, balanced, thrifty, minimal, mini-runner"
      exit 1 ;;
  esac
}

# ============================================================================
# Config file
# ============================================================================

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agent-init"
CONFIG_FILE="$CONFIG_DIR/config"

load_config_file() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  while IFS='=' read -r key value || [[ -n "$key" ]]; do
    key="${key%%#*}"; key="${key// /}"
    value="${value%%#*}"; value="${value// /}"
    [[ -z "$key" || -z "$value" ]] && continue
    case "$key" in
      agent|default-agent|default_agent)        AGENT_MODE="$value" ;;
      planner)                                  CLAUDE_PLANNER="$value" ;;
      reviewer|code-reviewer)                   CLAUDE_REVIEWER="$value" ;;
      test-runner|test_runner|tester)           CLAUDE_TESTRUNNER="$value" ;;
      debugger)                                 CLAUDE_DEBUGGER="$value" ;;
      codex-planner|codex_planner)              CODEX_PLANNER="$value" ;;
      codex-reviewer|codex_reviewer)            CODEX_REVIEWER="$value" ;;
      codex-test-runner|codex_test_runner)      CODEX_TESTRUNNER="$value" ;;
      codex-debugger|codex_debugger)            CODEX_DEBUGGER="$value" ;;
      codex-planner-effort|codex_planner_effort) CODEX_PLANNER_EFFORT="$value" ;;
      codex-reviewer-effort|codex_reviewer_effort) CODEX_REVIEWER_EFFORT="$value" ;;
      codex-test-runner-effort|codex_test_runner_effort) CODEX_TESTRUNNER_EFFORT="$value" ;;
      codex-debugger-effort|codex_debugger_effort) CODEX_DEBUGGER_EFFORT="$value" ;;
    esac
  done < "$CONFIG_FILE"
}
load_config_file

# Env vars override config file
[[ -n "${AGENT_INIT_AGENT:-}" ]]                && AGENT_MODE="$AGENT_INIT_AGENT"
[[ -n "${AGENT_INIT_PLANNER_MODEL:-}" ]]        && CLAUDE_PLANNER="$AGENT_INIT_PLANNER_MODEL"
[[ -n "${AGENT_INIT_REVIEWER_MODEL:-}" ]]       && CLAUDE_REVIEWER="$AGENT_INIT_REVIEWER_MODEL"
[[ -n "${AGENT_INIT_TESTRUNNER_MODEL:-}" ]]     && CLAUDE_TESTRUNNER="$AGENT_INIT_TESTRUNNER_MODEL"
[[ -n "${AGENT_INIT_DEBUGGER_MODEL:-}" ]]       && CLAUDE_DEBUGGER="$AGENT_INIT_DEBUGGER_MODEL"
[[ -n "${AGENT_INIT_CODEX_PLANNER_MODEL:-}" ]]    && CODEX_PLANNER="$AGENT_INIT_CODEX_PLANNER_MODEL"
[[ -n "${AGENT_INIT_CODEX_REVIEWER_MODEL:-}" ]]   && CODEX_REVIEWER="$AGENT_INIT_CODEX_REVIEWER_MODEL"
[[ -n "${AGENT_INIT_CODEX_TESTRUNNER_MODEL:-}" ]] && CODEX_TESTRUNNER="$AGENT_INIT_CODEX_TESTRUNNER_MODEL"
[[ -n "${AGENT_INIT_CODEX_DEBUGGER_MODEL:-}" ]]   && CODEX_DEBUGGER="$AGENT_INIT_CODEX_DEBUGGER_MODEL"

# ============================================================================
# Argument parsing
# ============================================================================

# First positional may be a subcommand
ARGS=()
if [[ $# -gt 0 ]]; then
  case "$1" in
    init|sync|doctor|migrate) SUBCOMMAND="$1"; shift ;;
  esac
fi

# Pre-pass: presets (so individual flags can override them)
for a in "$@"; do
  case "$a" in
    --preset=*)       apply_claude_preset "${a#*=}" ;;
    --codex-preset=*) apply_codex_preset "${a#*=}" ;;
  esac
done

# Main pass
for a in "$@"; do
  case "$a" in
    --force)        FORCE=1 ;;
    --dry-run)      DRY_RUN=1 ;;
    --quiet)        VERBOSE=0 ;;
    --configure)    CONFIGURE=1 ;;
    --show-config)  SHOW_CONFIG=1 ;;
    --preset=*)     ;;  # handled in pre-pass
    --codex-preset=*) ;;
    --agent=*)      AGENT_MODE="${a#*=}" ;;
    --planner=*)        CLAUDE_PLANNER="${a#*=}" ;;
    --reviewer=*)       CLAUDE_REVIEWER="${a#*=}" ;;
    --code-reviewer=*)  CLAUDE_REVIEWER="${a#*=}" ;;
    --test-runner=*)    CLAUDE_TESTRUNNER="${a#*=}" ;;
    --testrunner=*)     CLAUDE_TESTRUNNER="${a#*=}" ;;
    --debugger=*)       CLAUDE_DEBUGGER="${a#*=}" ;;
    --codex-planner=*)        CODEX_PLANNER="${a#*=}" ;;
    --codex-reviewer=*)       CODEX_REVIEWER="${a#*=}" ;;
    --codex-test-runner=*)    CODEX_TESTRUNNER="${a#*=}" ;;
    --codex-testrunner=*)     CODEX_TESTRUNNER="${a#*=}" ;;
    --codex-debugger=*)       CODEX_DEBUGGER="${a#*=}" ;;
    -h|--help)
      sed -n '2,/^set -euo/p' "$0" | sed 's/^# \?//' | sed '$d'
      exit 0 ;;
    *) echo "Unknown arg: $a (try --help)" >&2; exit 1 ;;
  esac
done

# Validate
validate_agent_mode "$AGENT_MODE"
validate_claude_model "$CLAUDE_PLANNER"
validate_claude_model "$CLAUDE_REVIEWER"
validate_claude_model "$CLAUDE_TESTRUNNER"
validate_claude_model "$CLAUDE_DEBUGGER"
validate_codex_model "$CODEX_PLANNER"
validate_codex_model "$CODEX_REVIEWER"
validate_codex_model "$CODEX_TESTRUNNER"
validate_codex_model "$CODEX_DEBUGGER"

# Convenience: returns 1 if Claude artifacts should be generated
needs_claude() { [[ "$AGENT_MODE" == "claude" || "$AGENT_MODE" == "both" ]]; }
needs_codex()  { [[ "$AGENT_MODE" == "codex"  || "$AGENT_MODE" == "both" ]]; }

# ============================================================================
# --show-config
# ============================================================================

if [[ $SHOW_CONFIG -eq 1 ]]; then
  echo "agent-init v$VERSION — resolved configuration"
  echo
  echo "Agent mode:    $AGENT_MODE"
  echo
  echo "Claude specialists (used when agent ∈ {claude, both}):"
  echo "  planner       $CLAUDE_PLANNER"
  echo "  code-reviewer $CLAUDE_REVIEWER"
  echo "  test-runner   $CLAUDE_TESTRUNNER"
  echo "  debugger      $CLAUDE_DEBUGGER"
  echo
  echo "Codex specialists (used when agent ∈ {codex, both}):"
  echo "  planner       $CODEX_PLANNER   (effort: $CODEX_PLANNER_EFFORT)"
  echo "  code-reviewer $CODEX_REVIEWER   (effort: $CODEX_REVIEWER_EFFORT)"
  echo "  test-runner   $CODEX_TESTRUNNER   (effort: $CODEX_TESTRUNNER_EFFORT)"
  echo "  debugger      $CODEX_DEBUGGER   (effort: $CODEX_DEBUGGER_EFFORT)"
  echo
  if [[ -f "$CONFIG_FILE" ]]; then
    echo "Config file:   $CONFIG_FILE (loaded)"
  else
    echo "Config file:   $CONFIG_FILE (not present — using defaults)"
  fi
  exit 0
fi

# ============================================================================
# --configure
# ============================================================================

if [[ $CONFIGURE -eq 1 ]]; then
  if [[ ! -t 0 ]]; then
    err "--configure needs an interactive terminal (stdin is not a TTY)."
    exit 1
  fi
  log ""
  log "${B}agent-init configuration${R}"
  log ""
  log "Sets global defaults written to $CONFIG_FILE."
  log "Per-project, override with flags or per-shell env vars."
  log ""

  prompt_value() {
    local label="$1" varname="$2" current="$3" valid_rx="$4" choices="$5" choice
    while true; do
      printf "%-32s [current: %s] : " "$label" "$current" >&2
      read -r choice
      [[ -z "$choice" ]] && choice="$current"
      if [[ "$choice" =~ $valid_rx ]]; then
        eval "$varname=\"$choice\""; break
      else
        printf "  ↳ '%s' is not valid. Choices: %s\n" "$choice" "$choices" >&2
      fi
    done
  }

  prompt_value "Default agent (claude|codex|both)" AGENT_MODE "$AGENT_MODE" '^(claude|codex|both)$' "claude, codex, both"
  log ""
  log "${B}Claude specialist models${R} (opus, sonnet, haiku)"
  prompt_value "  planner"        CLAUDE_PLANNER    "$CLAUDE_PLANNER"    "$CLAUDE_MODELS_RX" "opus, sonnet, haiku"
  prompt_value "  code-reviewer"  CLAUDE_REVIEWER   "$CLAUDE_REVIEWER"   "$CLAUDE_MODELS_RX" "opus, sonnet, haiku"
  prompt_value "  test-runner"    CLAUDE_TESTRUNNER "$CLAUDE_TESTRUNNER" "$CLAUDE_MODELS_RX" "opus, sonnet, haiku"
  prompt_value "  debugger"       CLAUDE_DEBUGGER   "$CLAUDE_DEBUGGER"   "$CLAUDE_MODELS_RX" "opus, sonnet, haiku"
  log ""
  log "${B}Codex specialist models${R} (gpt-5-pro, gpt-5.4, gpt-5.4-mini, ...)"
  prompt_value "  planner"        CODEX_PLANNER    "$CODEX_PLANNER"    "$CODEX_MODELS_RX" "gpt-5-pro, gpt-5.4, gpt-5.4-mini"
  prompt_value "  code-reviewer"  CODEX_REVIEWER   "$CODEX_REVIEWER"   "$CODEX_MODELS_RX" "gpt-5-pro, gpt-5.4, gpt-5.4-mini"
  prompt_value "  test-runner"    CODEX_TESTRUNNER "$CODEX_TESTRUNNER" "$CODEX_MODELS_RX" "gpt-5-pro, gpt-5.4, gpt-5.4-mini"
  prompt_value "  debugger"       CODEX_DEBUGGER   "$CODEX_DEBUGGER"   "$CODEX_MODELS_RX" "gpt-5-pro, gpt-5.4, gpt-5.4-mini"

  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" <<EOF
# agent-init global config
# Per-project overrides: --agent=both, --planner=opus, --codex-preset=balanced, etc.

agent=$AGENT_MODE

# Claude specialist models (opus, sonnet, haiku)
planner=$CLAUDE_PLANNER
reviewer=$CLAUDE_REVIEWER
test-runner=$CLAUDE_TESTRUNNER
debugger=$CLAUDE_DEBUGGER

# Codex specialist models (gpt-5-pro, gpt-5.4, gpt-5.4-mini, ...)
codex-planner=$CODEX_PLANNER
codex-reviewer=$CODEX_REVIEWER
codex-test-runner=$CODEX_TESTRUNNER
codex-debugger=$CODEX_DEBUGGER

# Codex reasoning effort per specialist (low, medium, high)
codex-planner-effort=$CODEX_PLANNER_EFFORT
codex-reviewer-effort=$CODEX_REVIEWER_EFFORT
codex-test-runner-effort=$CODEX_TESTRUNNER_EFFORT
codex-debugger-effort=$CODEX_DEBUGGER_EFFORT
EOF
  log ""
  ok "Saved to $CONFIG_FILE"
  exit 0
fi

# ============================================================================
# Preflight
# ============================================================================

if ! command -v jq >/dev/null 2>&1; then
  err "jq not found. Install: brew install jq (macOS) or apt install jq (Linux)"
  exit 1
fi

# Tool checks are advisory, not blocking — you may scaffold for an agent you
# haven't installed yet.
if needs_claude && ! command -v claude >/dev/null 2>&1; then
  warn "claude CLI not found (scaffolding for Claude anyway). Install when ready: npm i -g @anthropic-ai/claude-code"
fi
if needs_codex && ! command -v codex >/dev/null 2>&1; then
  warn "codex CLI not found (scaffolding for Codex anyway). Install when ready: npm i -g @openai/codex"
fi

# Git check (advisory)
if [[ ! -d .git ]] && [[ "$SUBCOMMAND" != "doctor" ]]; then
  warn "Not a git repo. Hooks and conventions assume git. Consider 'git init' first."
fi

PROJECT_NAME="$(basename "$PWD")"
SOT_DIR=".agents"   # source-of-truth directory

# ============================================================================
# Stack detection (polyglot)
# ============================================================================

STACKS=()
[[ -f package.json ]] && STACKS+=("Node/TypeScript")
[[ -f pyproject.toml || -f requirements.txt || -f setup.py || -f Pipfile ]] && STACKS+=("Python")
[[ -f Cargo.toml ]] && STACKS+=("Rust")
[[ -f go.mod ]] && STACKS+=("Go")
[[ -f Gemfile ]] && STACKS+=("Ruby")
[[ -f composer.json ]] && STACKS+=("PHP")
[[ -f pom.xml || -f build.gradle || -f build.gradle.kts ]] && STACKS+=("JVM")
shopt -s nullglob
TF_FILES=(*.tf)
[[ ${#TF_FILES[@]} -gt 0 ]] && STACKS+=("Terraform")
shopt -u nullglob
[[ -f serverless.yml || -f serverless.yaml ]] && STACKS+=("Serverless Framework")
[[ -f Dockerfile || -f docker-compose.yml || -f compose.yml ]] && STACKS+=("Docker")
[[ ${#STACKS[@]} -eq 0 ]] && STACKS=("(no stack detected — fill in AGENTS.md manually)")

# Detect commands
BUILD_CMD=""; TEST_CMD=""; LINT_CMD=""; DEV_CMD=""
if [[ -f package.json ]]; then
  jq -e '.scripts.test'  package.json >/dev/null 2>&1 && TEST_CMD="npm test"
  jq -e '.scripts.build' package.json >/dev/null 2>&1 && BUILD_CMD="npm run build"
  jq -e '.scripts.lint'  package.json >/dev/null 2>&1 && LINT_CMD="npm run lint"
  jq -e '.scripts.dev'   package.json >/dev/null 2>&1 && DEV_CMD="npm run dev"
fi
if [[ -z "$TEST_CMD" ]]; then
  if [[ -f pyproject.toml || -f requirements.txt || -f setup.py ]]; then
    TEST_CMD="pytest -q"
  elif [[ -f Cargo.toml ]]; then TEST_CMD="cargo test"
  elif [[ -f go.mod ]]; then TEST_CMD="go test ./..."
  fi
fi

# ============================================================================
# Write helpers (idempotent)
# ============================================================================

write_text() {
  local path="$1"; local body="$2"
  # Normalize: strip trailing newlines/whitespace so equality comparison is robust
  # against accumulated heredoc trailing newlines.
  while [[ "$body" == *$'\n' ]]; do body="${body%$'\n'}"; done
  if [[ -e "$path" ]]; then
    local on_disk
    on_disk="$(cat "$path" 2>/dev/null || true)"
    while [[ "$on_disk" == *$'\n' ]]; do on_disk="${on_disk%$'\n'}"; done
    if [[ "$on_disk" == "$body" ]]; then
      if [[ $FORCE -eq 1 ]]; then
        keep "$path (already current — no rewrite needed)"
      else
        keep "$path (unchanged)"
      fi
      return 0
    fi
    if [[ $FORCE -eq 1 ]]; then
      if [[ $DRY_RUN -eq 1 ]]; then plan_ "would back up + overwrite $path"; return 0; fi
      cp "$path" "${path}.bak.${TIMESTAMP}"; back "${path}.bak.${TIMESTAMP}"
    else
      keep "$path (exists, differs; --force to overwrite)"; return 0
    fi
  fi
  if [[ $DRY_RUN -eq 1 ]]; then plan_ "would create $path"; return 0; fi
  mkdir -p "$(dirname "$path")"
  printf "%s\n" "$body" > "$path"
  make_ "$path"
}

write_exec() {
  write_text "$1" "$2"
  if [[ $DRY_RUN -eq 0 && -e "$1" ]]; then
    chmod +x "$1"
  fi
  return 0
}

ensure_symlink() {
  local link="$1" target="$2"
  if [[ -L "$link" ]]; then
    local current
    current="$(readlink "$link")"
    if [[ "$current" == "$target" ]]; then
      keep "$link → $target (unchanged)"
      return 0
    fi
    if [[ $DRY_RUN -eq 1 ]]; then plan_ "would update symlink $link → $target"; return 0; fi
    rm "$link"
  elif [[ -e "$link" ]]; then
    if [[ $FORCE -eq 1 ]]; then
      if [[ $DRY_RUN -eq 1 ]]; then plan_ "would back up + replace $link with symlink → $target"; return 0; fi
      mv "$link" "${link}.bak.${TIMESTAMP}"; back "${link}.bak.${TIMESTAMP}"
    else
      keep "$link (exists as file, not symlink; --force to replace)"; return 0
    fi
  fi
  if [[ $DRY_RUN -eq 1 ]]; then plan_ "would create symlink $link → $target"; return 0; fi
  mkdir -p "$(dirname "$link")"
  ln -s "$target" "$link"
  make_ "$link → $target"
}

# ============================================================================
# Gitignore
# ============================================================================

add_gitignore() {
  local entries=(
    ".agents/local/"
    ".agents/SKIP_TESTS"
    ".claude/settings.local.json"
    ".codex/auth.json"
    "*.bak.[0-9]*"
  )
  if [[ ! -f .gitignore ]]; then
    if [[ $DRY_RUN -eq 1 ]]; then plan_ "would create .gitignore"; return; fi
    printf "# Agent tooling\n" > .gitignore
    make_ ".gitignore"
  fi
  for e in "${entries[@]}"; do
    if ! grep -qxF "$e" .gitignore 2>/dev/null; then
      if [[ $DRY_RUN -eq 1 ]]; then plan_ "would add '$e' to .gitignore"; continue; fi
      printf "%s\n" "$e" >> .gitignore
      make_ ".gitignore += $e"
    fi
  done
}

# ============================================================================
# Subcommand dispatch (rest of script wired up below)
# ============================================================================

case "$SUBCOMMAND" in
  init|sync|doctor|migrate) ;;
  *) err "Unknown subcommand '$SUBCOMMAND'"; exit 1 ;;
esac

