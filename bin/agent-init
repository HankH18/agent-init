render_claude_settings() {
  cat <<'JSON'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/danger-guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/format.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/test-on-stop.sh" }
        ]
      }
    ]
  }
}
JSON
}

# Render a Claude specialist (.md with YAML frontmatter) from a .agents/specialists/*.yaml IR.
# Args: $1=ir_yaml_file, $2=claude_model
render_claude_specialist() {
  local ir="$1" model="$2"
  # Extract fields from YAML (simple parser — assumes our own format)
  local name desc tools sys_prompt
  name="$(awk '/^name:/{print $2; exit}' "$ir")"
  desc="$(awk '/^description:/{sub(/^description:[[:space:]]*/,""); print; exit}' "$ir")"
  tools="$(awk '/^tools_claude:/{sub(/^tools_claude:[[:space:]]*/,""); print; exit}' "$ir")"
  # Extract multi-line system_prompt: everything after the "system_prompt: |" line
  sys_prompt="$(awk '/^system_prompt:[[:space:]]*\|/{flag=1; next} flag{sub(/^  /,""); print}' "$ir")"

  cat <<EOF
---
name: $name
description: $desc
tools: $tools
model: $model
---

$sys_prompt
EOF
}

# Render a Codex specialist (.toml) from the IR.
# Args: $1=ir_yaml_file, $2=codex_model, $3=codex_effort
render_codex_specialist() {
  local ir="$1" model="$2" effort="$3"
  local name desc sandbox sys_prompt
  name="$(awk '/^name:/{print $2; exit}' "$ir")"
  desc="$(awk '/^description:/{sub(/^description:[[:space:]]*/,""); print; exit}' "$ir")"
  sandbox="$(awk '/^sandbox_codex:/{print $2; exit}' "$ir")"
  [[ -z "$sandbox" ]] && sandbox="workspace-write"
  sys_prompt="$(awk '/^system_prompt:[[:space:]]*\|/{flag=1; next} flag{sub(/^  /,""); print}' "$ir")"

  cat <<EOF
name = "$name"
description = "$desc"
model = "$model"
model_reasoning_effort = "$effort"
sandbox_mode = "$sandbox"
developer_instructions = """
$sys_prompt
"""
EOF
}

# Render the Codex config.toml header (top-level settings + [agents] registry).
render_codex_config() {
  cat <<EOF
# Generated by agent-init v${VERSION} on $(date +%Y-%m-%d). Do not hand-edit.
# Edit .agents/specialists/*.yaml then run \`agent-init sync\`.

model = "$CODEX_REVIEWER"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
model_reasoning_effort = "medium"

[features]
codex_hooks = true
multi_agent = true

[sandbox_workspace_write]
network_access = false

[agents]
max_threads = 4
max_depth = 1

[agents.planner]
description = "Decomposes complex tasks into ordered, verifiable steps before any code is written."
config_file = ".codex/agents/planner.toml"

[agents.code-reviewer]
description = "Reviews diffs for correctness, security, and missing tests."
config_file = ".codex/agents/code-reviewer.toml"

[agents.test-runner]
description = "Runs and triages test failures in the current workspace."
config_file = ".codex/agents/test-runner.toml"

[agents.debugger]
description = "Reproduces and root-causes bugs from a failing test or error message."
config_file = ".codex/agents/debugger.toml"
EOF

  # MCP servers — render from .agents/mcp.yaml if present
  if [[ -f "$SOT_DIR/mcp.yaml" ]]; then
    echo ""
    echo "# MCP servers (rendered from $SOT_DIR/mcp.yaml — uncomment to enable)"
    render_codex_mcp_blocks
  fi
}

render_codex_hooks_json() {
  cat <<'JSON'
{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^Bash$",
      "hooks": [{
        "type": "command",
        "command": ".agents/hooks/danger-guard.sh",
        "timeout": 30,
        "statusMessage": "Checking command for destructive patterns"
      }]
    }],
    "PostToolUse": [{
      "matcher": "apply_patch|Bash",
      "hooks": [{
        "type": "command",
        "command": ".agents/hooks/format.sh",
        "timeout": 60
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": ".agents/hooks/test-on-stop.sh",
        "timeout": 600
      }]
    }]
  }
}
JSON
}

# Render Codex MCP server TOML blocks from .agents/mcp.yaml.
# Simple YAML parser — assumes our exact format.
render_codex_mcp_blocks() {
  awk '
    BEGIN { in_server=0 }
    /^[[:space:]]*-[[:space:]]+name:/ {
      if (in_server) print ""
      gsub(/^[[:space:]]*-[[:space:]]+name:[[:space:]]*/, "")
      gsub(/[[:space:]]+$/, "")
      name=$0
      in_server=1
      transport=""; cmd=""; args_line=""; url=""; auth_env=""; desc=""
      next
    }
    in_server && /^[[:space:]]+description:/ { sub(/^[[:space:]]+description:[[:space:]]*/, ""); desc=$0; next }
    in_server && /^[[:space:]]+transport:/   { sub(/^[[:space:]]+transport:[[:space:]]*/,   ""); transport=$0; next }
    in_server && /^[[:space:]]+command:/     { sub(/^[[:space:]]+command:[[:space:]]*/,     ""); cmd=$0; next }
    in_server && /^[[:space:]]+args:/        { sub(/^[[:space:]]+args:[[:space:]]*/,        ""); args_line=$0; next }
    in_server && /^[[:space:]]+url:/         { sub(/^[[:space:]]+url:[[:space:]]*/,         ""); url=$0; next }
    in_server && /^[[:space:]]+auth_env:/    { sub(/^[[:space:]]+auth_env:[[:space:]]*/,    ""); auth_env=$0; next }
    in_server && /^[a-zA-Z]/ {
      flush_server()
      in_server=0
    }
    END { if (in_server) flush_server() }

    function flush_server() {
      if (name == "") return
      printf "\n# %s\n", desc
      printf "# [mcp_servers.%s]\n", name
      if (transport == "http") {
        printf "# url = \"%s\"\n", url
        if (auth_env != "") printf "# bearer_token_env_var = \"%s\"\n", auth_env
      } else {
        if (cmd != "") printf "# command = \"%s\"\n", cmd
        if (args_line != "") {
          # args_line is like: [-y, "@upstash/context7-mcp"]
          gsub(/^\[/, "", args_line); gsub(/\][[:space:]]*$/, "", args_line)
          printf "# args = [%s]\n", args_line
        }
      }
    }
  ' "$SOT_DIR/mcp.yaml"
}

# Render Claude MCP_SETUP.md (concise install commands + reference to .agents/mcp.yaml).
render_claude_mcp_setup() {
  cat <<'EOF'
# MCP Setup — Claude Code

Servers are defined in `.agents/mcp.yaml` (logical, tool-agnostic). This doc
shows the equivalent `claude mcp add` commands.

## Quick installs

```bash
# GitHub (official, hosted, OAuth)
claude mcp add --transport http --scope user github https://api.githubcopilot.com/mcp/ \
  --header "Authorization: Bearer $GITHUB_PAT"

# Context7 (live library docs)
claude mcp add --scope user context7 "npx -y @upstash/context7-mcp"

# Postgres / Redshift
claude mcp add --scope project postgres "npx -y @modelcontextprotocol/server-postgres" \
  --env "POSTGRES_CONNECTION_STRING=postgres://USER:PASS@HOST:5432/DB"

# Playwright (browser automation)
claude mcp add --scope project playwright "npx -y @playwright/mcp@latest"

# Sentry (OAuth)
claude mcp add --transport http --scope user sentry https://mcp.sentry.dev/mcp
```

## Discipline

- Cap at 5–7 servers per project — even with Tool Search, more = slower selection.
- Vendor-maintained > community. Audit credentials quarterly.
- Pin versions in `.mcp.json` once a server works.
- Project-scope for shared dev tools; user-scope for personal credentials.

See `.agents/mcp.yaml` for the canonical list; edit it and run `agent-init sync`.

For comprehensive references including 60+ servers, see the original repo docs.
EOF
}

# Render Codex MCP_SETUP.md.
render_codex_mcp_setup() {
  cat <<'EOF'
# MCP Setup — Codex CLI

Servers are defined in `.agents/mcp.yaml` (logical, tool-agnostic). This doc
shows the equivalent Codex CLI commands and TOML blocks.

## Quick installs

```bash
# GitHub (HTTP, bearer token)
codex mcp add --url https://api.githubcopilot.com/mcp/ github \
  --header "Authorization: Bearer $GITHUB_PAT"

# Context7 (stdio)
codex mcp add context7 -- npx -y @upstash/context7-mcp

# Playwright
codex mcp add playwright -- npx @playwright/mcp@latest

# Sentry (OAuth)
codex mcp add --url https://mcp.sentry.dev/mcp sentry
codex mcp authenticate sentry
```

## TOML blocks (for `~/.codex/config.toml` or `.codex/config.toml`)

```toml
[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
bearer_token_env_var = "GITHUB_PAT"

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp"]

[mcp_servers.postgres]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-postgres"]
env_vars = ["POSTGRES_CONNECTION_STRING"]

[mcp_servers.playwright]
command = "npx"
args = ["@playwright/mcp@latest"]

[mcp_servers.sentry]
url = "https://mcp.sentry.dev/mcp"
```

## Discipline

- Project-scoped MCP servers in `.codex/config.toml` only load for **trusted projects**.
  Run `codex` once and accept the trust prompt before they'll fire.
- Use `bearer_token_env_var` (not literal secrets in TOML).
- Codex doesn't support classic SSE for stdio servers — only stdio and streamable HTTP.

See `.agents/mcp.yaml` for the canonical list; edit it and run `agent-init sync`.
EOF
}

# ============================================================================
# Map Claude model tier ↔ Codex model
# ============================================================================

# Given a specialist name, return the configured Claude model.
claude_model_for() {
  case "$1" in
    planner)       echo "$CLAUDE_PLANNER" ;;
    code-reviewer) echo "$CLAUDE_REVIEWER" ;;
    test-runner)   echo "$CLAUDE_TESTRUNNER" ;;
    debugger)      echo "$CLAUDE_DEBUGGER" ;;
    *)             echo "sonnet" ;;
  esac
}

# Same for Codex.
codex_model_for() {
  case "$1" in
    planner)       echo "$CODEX_PLANNER" ;;
    code-reviewer) echo "$CODEX_REVIEWER" ;;
    test-runner)   echo "$CODEX_TESTRUNNER" ;;
    debugger)      echo "$CODEX_DEBUGGER" ;;
    *)             echo "gpt-5.4" ;;
  esac
}

codex_effort_for() {
  case "$1" in
    planner)       echo "$CODEX_PLANNER_EFFORT" ;;
    code-reviewer) echo "$CODEX_REVIEWER_EFFORT" ;;
    test-runner)   echo "$CODEX_TESTRUNNER_EFFORT" ;;
    debugger)      echo "$CODEX_DEBUGGER_EFFORT" ;;
    *)             echo "medium" ;;
  esac
}

# ============================================================================
# Source-of-truth materialization
# ============================================================================

write_source_of_truth() {
  # AGENTS.md
  write_text "AGENTS.md" "$(build_agents_md)"

  # Specialists
  write_text "$SOT_DIR/specialists/planner.yaml"       "$(build_specialist_planner)"
  write_text "$SOT_DIR/specialists/code-reviewer.yaml" "$(build_specialist_reviewer)"
  write_text "$SOT_DIR/specialists/test-runner.yaml"   "$(build_specialist_testrunner)"
  write_text "$SOT_DIR/specialists/debugger.yaml"      "$(build_specialist_debugger)"

  # Skills
  write_text "$SOT_DIR/skills/plan/SKILL.md"   "$(build_skill_plan)"
  write_text "$SOT_DIR/skills/review/SKILL.md" "$(build_skill_review)"
  write_text "$SOT_DIR/skills/ship/SKILL.md"   "$(build_skill_ship)"

  # Hooks
  write_exec "$SOT_DIR/hooks/format.sh"       "$(build_hook_format)"
  write_exec "$SOT_DIR/hooks/danger-guard.sh" "$(build_hook_danger)"
  write_exec "$SOT_DIR/hooks/test-on-stop.sh" "$(build_hook_stop)"

  # MCP
  write_text "$SOT_DIR/mcp.yaml" "$(build_mcp_yaml)"
}

render_claude_tree() {
  needs_claude || return 0
  if [[ $DRY_RUN -eq 1 ]]; then
    # In dry-run mode the source of truth wasn't actually written, so the
    # YAML→Markdown renderer would fail trying to read it. Just announce intent.
    plan_ "would create CLAUDE.md (bridge)"
    plan_ "would create .claude/settings.json"
    plan_ "would create .claude/agents/{planner,code-reviewer,test-runner,debugger}.md"
    plan_ "would create .claude/commands/{plan,review,ship}.md"
    plan_ "would create .claude/MCP_SETUP.md"
    return 0
  fi

  # Bridge file
  write_text "CLAUDE.md" "$(build_claude_md_bridge)"

  # Hooks config
  write_text ".claude/settings.json" "$(render_claude_settings)"

  # Specialists
  for s in planner code-reviewer test-runner debugger; do
    local model
    model="$(claude_model_for "$s")"
    write_text ".claude/agents/$s.md" "$(render_claude_specialist "$SOT_DIR/specialists/$s.yaml" "$model")"
  done

  # Slash commands (point at the shared skills)
  write_text ".claude/commands/plan.md"   "$(printf -- '---\ndescription: Decompose a feature request via the plan skill.\n---\n\nUse the `plan` skill from `.agents/skills/plan/SKILL.md`. Pass: $ARGUMENTS\n')"
  write_text ".claude/commands/review.md" "$(printf -- '---\ndescription: Review uncommitted changes via the review skill.\n---\n\nUse the `review` skill from `.agents/skills/review/SKILL.md`. Pass: $ARGUMENTS\n')"
  write_text ".claude/commands/ship.md"   "$(printf -- '---\ndescription: Run tests and commit via the ship skill.\n---\n\nUse the `ship` skill from `.agents/skills/ship/SKILL.md`. Pass: $ARGUMENTS\n')"

  # MCP reference
  write_text ".claude/MCP_SETUP.md" "$(render_claude_mcp_setup)"
}

render_codex_tree() {
  needs_codex || return 0
  if [[ $DRY_RUN -eq 1 ]]; then
    plan_ "would create .codex/config.toml"
    plan_ "would create .codex/hooks.json"
    plan_ "would create .codex/agents/{planner,code-reviewer,test-runner,debugger}.toml"
    plan_ "would create .codex/skills/{plan,review,ship} as symlinks to .agents/skills/"
    plan_ "would create .codex/MCP_SETUP.md"
    return 0
  fi

  # Config
  write_text ".codex/config.toml" "$(render_codex_config)"
  write_text ".codex/hooks.json"  "$(render_codex_hooks_json)"

  # Specialists
  for s in planner code-reviewer test-runner debugger; do
    local model effort
    model="$(codex_model_for "$s")"
    effort="$(codex_effort_for "$s")"
    write_text ".codex/agents/$s.toml" "$(render_codex_specialist "$SOT_DIR/specialists/$s.yaml" "$model" "$effort")"
  done

  # Skills — symlink the directories so edits to .agents/skills/ propagate.
  for skill in plan review ship; do
    ensure_symlink ".codex/skills/$skill" "../../.agents/skills/$skill"
  done

  # MCP reference
  write_text ".codex/MCP_SETUP.md" "$(render_codex_mcp_setup)"
}

# ============================================================================
# Subcommand: init
# ============================================================================

run_init() {
  log ""
  log "${B}agent-init v${VERSION}${R}  (subcommand: init)"
  log "${D}project:${R} ${PROJECT_NAME}"
  log "${D}agent:${R}   $AGENT_MODE"
  log "${D}stack:${R}   $(IFS=, ; echo "${STACKS[*]}")"
  [[ $DRY_RUN -eq 1 ]] && warn "DRY RUN — no files will be written"
  log ""

  write_source_of_truth
  render_claude_tree
  render_codex_tree
  add_gitignore

  log ""
  log "${GR}${B}Done.${R}"
  log ""
  log "Specialist models applied:"
  if needs_claude; then
    log "  ${D}Claude:${R} planner=$(cap_claude "$CLAUDE_PLANNER") · reviewer=$(cap_claude "$CLAUDE_REVIEWER") · test-runner=$(cap_claude "$CLAUDE_TESTRUNNER") · debugger=$(cap_claude "$CLAUDE_DEBUGGER")"
  fi
  if needs_codex; then
    log "  ${D}Codex:${R}  planner=$CODEX_PLANNER · reviewer=$CODEX_REVIEWER · test-runner=$CODEX_TESTRUNNER · debugger=$CODEX_DEBUGGER"
  fi
  log ""
  log "Next steps:"
  log "  ${D}1.${R}  Open ${B}AGENTS.md${R} and fill in the TODO sections."
  log "  ${D}2.${R}  Edit ${B}.agents/${R} files — they're the source of truth."
  log "  ${D}3.${R}  Run ${B}agent-init sync${R} after editing .agents/ to refresh .claude/ and .codex/."
  if needs_codex; then
    log ""
    log "${YL}Codex trust gate:${R} project-scoped .codex/ config (hooks, MCP) only loads"
    log "for trusted projects. Run ${B}codex${R} once in this dir and accept the trust prompt."
  fi
  log ""
  log "Maintenance:"
  log "  ${B}agent-init doctor${R}   detect drift / broken links / missing trust"
  log "  ${B}agent-init sync${R}     re-render .claude/ and .codex/ from .agents/"
  log "  ${B}agent-init migrate${R}  upgrade a legacy claude-init project to v2 layout"
  log ""
}

# ============================================================================
# Subcommand: sync
# ============================================================================

run_sync() {
  log ""
  log "${B}agent-init sync${R}  (re-render generated artifacts from .agents/)"
  log "${D}agent:${R} $AGENT_MODE"
  log ""

  if [[ ! -d "$SOT_DIR" ]]; then
    err "No $SOT_DIR/ directory found. Run \`agent-init init\` first."
    exit 1
  fi

  # sync = "make generated artifacts match source of truth"; always overwrite.
  FORCE=1

  # Re-render only — don't touch AGENTS.md or hooks (they live in .agents/)
  render_claude_tree
  render_codex_tree

  log ""
  log "${GR}${B}Synced.${R}"
}

# ============================================================================
# Subcommand: doctor
# ============================================================================

run_doctor() {
  log ""
  log "${B}agent-init doctor${R}  (drift, broken links, trust gate)"
  log ""

  local issues=0

  # 1. Source of truth exists
  if [[ ! -d "$SOT_DIR" ]]; then
    err "Missing $SOT_DIR/ — run \`agent-init init\` first."
    return 1
  fi
  ok "$SOT_DIR/ exists"

  # 2. AGENTS.md exists
  if [[ -f AGENTS.md ]]; then
    ok "AGENTS.md exists ($(wc -l < AGENTS.md) lines)"
    local lines
    lines=$(wc -l < AGENTS.md)
    if [[ $lines -gt 250 ]]; then
      warn "AGENTS.md is $lines lines — consider trimming. Agents follow ~150–200 lines reliably."
      issues=$((issues + 1))
    fi
  else
    err "AGENTS.md missing"
    issues=$((issues + 1))
  fi

  # 3. CLAUDE.md is a bridge (only if Claude is in play)
  if needs_claude; then
    if [[ -f CLAUDE.md ]]; then
      if grep -q "^@AGENTS.md" CLAUDE.md 2>/dev/null; then
        ok "CLAUDE.md is a valid @AGENTS.md bridge"
      else
        warn "CLAUDE.md exists but doesn't @-import AGENTS.md — risk of drift between project memories."
        issues=$((issues + 1))
      fi
    else
      err "CLAUDE.md missing (required when --agent includes claude)"
      issues=$((issues + 1))
    fi
  fi

  # 4. Hook scripts exist and are executable
  for h in format.sh danger-guard.sh test-on-stop.sh; do
    if [[ ! -f "$SOT_DIR/hooks/$h" ]]; then
      err "Missing $SOT_DIR/hooks/$h"
      issues=$((issues + 1))
    elif [[ ! -x "$SOT_DIR/hooks/$h" ]]; then
      err "$SOT_DIR/hooks/$h is not executable (chmod +x to fix)"
      issues=$((issues + 1))
    else
      ok "$SOT_DIR/hooks/$h exists and is executable"
    fi
  done

  # 5. Claude tree drift detection (compare rendered output to actual files)
  if needs_claude; then
    if [[ ! -d .claude ]]; then
      err ".claude/ missing — run \`agent-init sync\`"
      issues=$((issues + 1))
    else
      local drift=0
      for s in planner code-reviewer test-runner debugger; do
        local model expected actual
        model="$(claude_model_for "$s")"
        expected="$(render_claude_specialist "$SOT_DIR/specialists/$s.yaml" "$model")"
        while [[ "$expected" == *$'\n' ]]; do expected="${expected%$'\n'}"; done
        if [[ -f ".claude/agents/$s.md" ]]; then
          actual="$(cat ".claude/agents/$s.md")"
          while [[ "$actual" == *$'\n' ]]; do actual="${actual%$'\n'}"; done
          if [[ "$expected" != "$actual" ]]; then
            warn ".claude/agents/$s.md is out of sync with .agents/specialists/$s.yaml"
            drift=$((drift + 1))
            issues=$((issues + 1))
          fi
        else
          err ".claude/agents/$s.md missing"
          issues=$((issues + 1))
        fi
      done
      [[ $drift -eq 0 ]] && ok "Claude specialists in sync with $SOT_DIR/specialists/"
    fi
  fi

  # 6. Codex tree drift + symlinks
  if needs_codex; then
    if [[ ! -d .codex ]]; then
      err ".codex/ missing — run \`agent-init sync\`"
      issues=$((issues + 1))
    else
      local drift=0
      for s in planner code-reviewer test-runner debugger; do
        local model effort expected actual
        model="$(codex_model_for "$s")"
        effort="$(codex_effort_for "$s")"
        expected="$(render_codex_specialist "$SOT_DIR/specialists/$s.yaml" "$model" "$effort")"
        while [[ "$expected" == *$'\n' ]]; do expected="${expected%$'\n'}"; done
        if [[ -f ".codex/agents/$s.toml" ]]; then
          actual="$(cat ".codex/agents/$s.toml")"
          while [[ "$actual" == *$'\n' ]]; do actual="${actual%$'\n'}"; done
          if [[ "$expected" != "$actual" ]]; then
            warn ".codex/agents/$s.toml is out of sync with .agents/specialists/$s.yaml"
            drift=$((drift + 1))
            issues=$((issues + 1))
          fi
        else
          err ".codex/agents/$s.toml missing"
          issues=$((issues + 1))
        fi
      done
      [[ $drift -eq 0 ]] && ok "Codex specialists in sync with $SOT_DIR/specialists/"

      # Skill symlinks
      for skill in plan review ship; do
        local link=".codex/skills/$skill" target="../../.agents/skills/$skill"
        if [[ -L "$link" ]]; then
          local current
          current="$(readlink "$link")"
          if [[ "$current" == "$target" ]]; then
            ok ".codex/skills/$skill → $target"
          else
            warn ".codex/skills/$skill points to '$current' (expected '$target')"
            issues=$((issues + 1))
          fi
        else
          warn ".codex/skills/$skill is not a symlink (run \`agent-init sync\` to fix)"
          issues=$((issues + 1))
        fi
      done

      # Codex trust-gate reminder (we can't check programmatically without invoking codex)
      note "Codex trust: project .codex/ (hooks, MCP) only loads after \`codex\` is run here and you accept the trust prompt."
    fi
  fi

  # 7. .gitignore sanity
  if [[ -f .gitignore ]]; then
    for must_ignore in ".codex/auth.json" ".claude/settings.local.json"; do
      if ! grep -qxF "$must_ignore" .gitignore 2>/dev/null; then
        warn ".gitignore does not list \`$must_ignore\` — credentials risk"
        issues=$((issues + 1))
      fi
    done
  else
    warn "No .gitignore — run \`agent-init init\` to create one"
    issues=$((issues + 1))
  fi

  log ""
  if [[ $issues -eq 0 ]]; then
    log "${GR}${B}✓ All checks passed.${R}"
  else
    log "${YL}${B}$issues issue(s) found.${R} Run \`agent-init sync${R} or ${B}--force\` to repair generated artifacts."
    exit 1
  fi
}

# ============================================================================
# Subcommand: migrate (upgrade legacy claude-init v1.x projects)
# ============================================================================

run_migrate() {
  log ""
  log "${B}agent-init migrate${R}  (upgrade legacy claude-init layout → agent-init v2)"
  log ""

  local legacy_signals=0
  [[ -d .claude && ! -d .agents ]] && legacy_signals=$((legacy_signals + 1))
  [[ -f CLAUDE.md ]] && ! grep -q "^@AGENTS.md" CLAUDE.md 2>/dev/null && legacy_signals=$((legacy_signals + 1))

  if [[ $legacy_signals -eq 0 ]]; then
    note "No legacy layout detected. Project may already be migrated, or it's a fresh init target."
    note "Run \`agent-init init\` to scaffold from scratch."
    exit 0
  fi

  log "Detected legacy claude-init layout. Migration plan:"
  log "  1. Move CLAUDE.md content → AGENTS.md (back up CLAUDE.md to *.bak.${TIMESTAMP})"
  log "  2. Write a new CLAUDE.md as a thin @AGENTS.md bridge"
  log "  3. Build .agents/ source-of-truth from current .claude/ files"
  log "  4. Re-render .claude/ from .agents/ (with backups)"
  log "  5. Optionally render .codex/ if --agent includes codex"
  log ""

  if [[ $DRY_RUN -eq 0 ]] && [[ -t 0 ]]; then
    printf "Proceed? [y/N] " >&2
    read -r ans
    [[ "$ans" != "y" && "$ans" != "Y" ]] && { warn "Cancelled."; exit 0; }
  fi

  # Step 1+2: promote CLAUDE.md → AGENTS.md, install bridge
  local agents_md_was_promoted=0
  if [[ -f CLAUDE.md ]] && ! grep -q "^@AGENTS.md" CLAUDE.md 2>/dev/null; then
    if [[ ! -f AGENTS.md ]]; then
      if [[ $DRY_RUN -eq 0 ]]; then
        cp CLAUDE.md "CLAUDE.md.bak.${TIMESTAMP}"; back "CLAUDE.md.bak.${TIMESTAMP}"
        # Strip Claude-specific header comments, write to AGENTS.md
        sed 's/<!-- Initialized by claude-init/<!-- Migrated by agent-init/' CLAUDE.md > AGENTS.md
        make_ "AGENTS.md (migrated from CLAUDE.md — your prose preserved)"
        printf "%s\n" "$(build_claude_md_bridge)" > CLAUDE.md
        make_ "CLAUDE.md (now a thin @AGENTS.md bridge)"
        agents_md_was_promoted=1
      else
        plan_ "would migrate CLAUDE.md → AGENTS.md and install bridge"
      fi
    else
      warn "AGENTS.md already exists — leaving CLAUDE.md alone. Manually verify alignment."
    fi
  fi

  # Step 3: build .agents/ source of truth — specialists, skills, hooks, mcp
  # NB: AGENTS.md skipped when we just promoted user content to it.
  warn "Specialist customizations in .claude/agents/*.md will be re-baselined from defaults."
  warn "Originals get backed up via --force semantics during render."
  FORCE=1   # force-overwrite the legacy .claude/ files so they get fresh symlinks/configs

  if [[ $agents_md_was_promoted -eq 0 ]]; then
    # Fresh migration without prior CLAUDE.md content — write default AGENTS.md template
    write_text "AGENTS.md" "$(build_agents_md)"
  fi

  # Specialists, skills, hooks, mcp — these are pure agent-init scaffolding
  write_text "$SOT_DIR/specialists/planner.yaml"       "$(build_specialist_planner)"
  write_text "$SOT_DIR/specialists/code-reviewer.yaml" "$(build_specialist_reviewer)"
  write_text "$SOT_DIR/specialists/test-runner.yaml"   "$(build_specialist_testrunner)"
  write_text "$SOT_DIR/specialists/debugger.yaml"      "$(build_specialist_debugger)"
  write_text "$SOT_DIR/skills/plan/SKILL.md"           "$(build_skill_plan)"
  write_text "$SOT_DIR/skills/review/SKILL.md"         "$(build_skill_review)"
  write_text "$SOT_DIR/skills/ship/SKILL.md"           "$(build_skill_ship)"
  write_exec "$SOT_DIR/hooks/format.sh"                "$(build_hook_format)"
  write_exec "$SOT_DIR/hooks/danger-guard.sh"          "$(build_hook_danger)"
  write_exec "$SOT_DIR/hooks/test-on-stop.sh"          "$(build_hook_stop)"
  write_text "$SOT_DIR/mcp.yaml"                       "$(build_mcp_yaml)"

  # Step 4: re-render .claude/
  render_claude_tree

  # Step 5: optionally render .codex/
  if needs_codex; then
    render_codex_tree
  fi

  add_gitignore

  log ""
  log "${GR}${B}Migration complete.${R}"
  log ""
  log "Originals backed up to *.bak.${TIMESTAMP}. Verify, then commit."
}

# ============================================================================
# Dispatch
# ============================================================================

case "$SUBCOMMAND" in
  init)    run_init ;;
  sync)    run_sync ;;
  doctor)  run_doctor ;;
  migrate) run_migrate ;;
esac
